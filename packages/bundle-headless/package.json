{
  "name": "@dsc/bundle-headless",
  "version": "0.1.0",
  "description": "The dsc one-shot bundle: metacodes-style -p/--print over the DeepSeek Harness base with --json result and --stream-json live NDJSON",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./startup": "./src/startup.ts",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsc": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@dsc/core": "workspace:*",
    "commander": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
