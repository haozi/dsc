{
  "name": "@dsc/cli",
  "version": "0.1.0",
  "description": "dsc CLI: profile boot, plugin management, and the metacodes-style command surface over the dsh plugin stack",
  "private": true,
  "type": "module",
  "bin": {
    "dsc": "./src/bin.ts"
  },
  "scripts": {
    "dev": "tsx watch src/bin.ts",
    "start": "tsx src/bin.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@dsc/core": "workspace:*",
    "commander": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
